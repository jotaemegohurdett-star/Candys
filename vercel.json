{
  "version": 2,
  "domains": ["candyspet.cl", "www.candyspet.cl"],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "sh scripts/build-vercel.sh",
  "outputDirectory": "artifacts/candys-pet/dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://candy-pet.replit.app/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}